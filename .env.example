# MongoDB connection (local compose: mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=jobagent

# Web service
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
# Random string, at least 32 characters; signs the session cookie.
SESSION_SECRET=
# Single-user dashboard password.
AUTH_PASSWORD=

# LLM provider (used from M2 onwards)
LLM_API_KEY=
LLM_MODEL=
